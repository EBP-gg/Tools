/binaries/tesseract/

# Tesstrain : ignore all training artifacts and the tesstrain repo files,
# keep only the ground truth dataset (PNG + .gt.txt) and the training script.
/tesstrain/*
!/tesstrain/data/
/tesstrain/data/*
!/tesstrain/data/evadigits-ground-truth/
!/tesstrain/train.sh
# .box and .lstmf are regenerated by tesstrain at each run — don't track.
/tesstrain/data/evadigits-ground-truth/*.box
/tesstrain/data/evadigits-ground-truth/*.lstmf
# Clé du mode système (pré-analyse) — jamais commitée
.ebp-system-key
